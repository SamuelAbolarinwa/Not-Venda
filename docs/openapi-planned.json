    "/v1/shops/{shopId}/drafts": {
      "post": {
        "summary": "PLANNED: Create versioned draft",
        "x-implemented": false,
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposed success shape described in partner-api.md; not executable"
          },
          "default": {
            "description": "Safe error envelope, including stale draft, confirmation expiry, revoked link and idempotency conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["sale"]
                  },
                  "channel": {
                    "type": "string",
                    "enum": ["web", "whatsapp"]
                  },
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "product_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "unit": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": ["product_id", "unit", "quantity"],
                      "additionalProperties": false
                    }
                  },
                  "payments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "method": {
                          "type": "string",
                          "enum": ["cash", "transfer", "pos"]
                        },
                        "amount_kobo": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]{0,18})$"
                        }
                      },
                      "required": ["method", "amount_kobo"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["kind", "channel", "lines", "payments"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
